# Input Handler Module for Buttons and Potentiometer
#
# This module reads physical controls from the user and converts them into values the rest
# of the software can understand.
#
# Inputs:
# - Potentiometer: analog input used as a brightness dial
# - Buttons: digital inputs used to power the system or switch operating modes

import machine
import time
from config import BUTTON_POWER, BUTTON_SELECT, POTENTIOMETER_PIN


class InputHandler:
    """
    Handles button inputs and potentiometer reading for power bank control.

    The ESP32 can read analog values from ADC pins. A potentiometer changes voltage based on
    its position, and the ADC converts that voltage into a number. The code then converts the
    ADC reading into a percentage for brightness control.
    """

    def __init__(self, callback_power=None, callback_select=None):
        # GPIO32 and GPIO33 are configured as digital inputs with pull-up resistors.
        # This means the default state is HIGH (1) when not pressed.
        # Pressing the button connects the input to GND, making it LOW (0).
        self.button_power = machine.Pin(BUTTON_POWER, machine.Pin.IN, machine.Pin.PULL_UP)
        self.button_select = machine.Pin(BUTTON_SELECT, machine.Pin.IN, machine.Pin.PULL_UP)

        # ADC input for the potentiometer.
        # The ESP32 ADC range is 0 to 4095 for a 0 to 3.3V input.
        self.adc = machine.ADC(machine.Pin(POTENTIOMETER_PIN))
        self.adc.atten(machine.ADC.ATTN_11DB)  # Full range 0-3.3V

        # Optional callback functions that allow this class to trigger actions in the main controller.
        self.callback_power = callback_power
        self.callback_select = callback_select

        # Keep track of the previous digital values so we can detect a button press edge.
        self.last_power_state = 1
        self.last_select_state = 1
        self.last_pot_value = 0

    def read_potentiometer(self, smoothing=5):
        """
        Read potentiometer value (0-100) with smoothing.

        The potentiometer output can jitter slightly due to noise, so we sample several times
        and take the average. This stabilises the brightness control.

        Args:
            smoothing (int): Number of samples to average

        Returns:
            int: 0-100 percent
        """
        readings = []

        for _ in range(smoothing):
            readings.append(self.adc.read())
            time.sleep(0.01)

        avg = sum(readings) // len(readings)

        # ADC values run from 0 to 4095. Convert that to a percentage for easier control.
        value = (avg / 4095) * 100
        return int(value)

    def check_buttons(self):
        """
        Check for button presses using edge detection.

        We want to detect when a button transitions from not pressed to pressed.
        This is called a falling edge, because the signal goes from HIGH to LOW.

        Returns:
            tuple: (power_pressed, select_pressed)
        """
        power_state = self.button_power.value()
        select_state = self.button_select.value()

        power_pressed = False
        select_pressed = False

        # Detect falling edge (button press, active low)
        # If last state was HIGH and current state is LOW, the button was pressed.
        if self.last_power_state == 1 and power_state == 0:
            power_pressed = True
            if self.callback_power:
                self.callback_power()

        if self.last_select_state == 1 and select_state == 0:
            select_pressed = True
            if self.callback_select:
                self.callback_select()

        # Save the latest state for the next check.
        self.last_power_state = power_state
        self.last_select_state = select_state

        return power_pressed, select_pressed

    def get_potentiometer(self):
        """Get the current potentiometer value as a percentage."""
        return self.read_potentiometer(smoothing=3)
